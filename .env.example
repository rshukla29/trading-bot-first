# Copy to .env and fill in. .env is gitignored — never commit real values.

# TWS paper trading default port is 7497; IB Gateway paper default is 4002.
# Live ports are 7496 (TWS) / 4001 (Gateway) — LIVE_TRADING must also be
# explicitly set to true before the bot will trade on a non-paper account.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Risk parameters
RISK_PCT_PER_TRADE=0.01
STOP_LOSS_PCT=0.20
MAX_POSITIONS=5
MAX_DAILY_LOSS_PCT=0.03

# Strategy parameters
FAST_MA=20
SLOW_MA=50

# Safety: must be explicitly "true" to allow trading on a non-paper (live) account.
LIVE_TRADING=false

# Comma-separated symbol watchlist
WATCHLIST=AAPL,MSFT,AMZN,GOOGL,META,NVDA,JPM,V,UNH,HD

DB_PATH=data/journal.db
