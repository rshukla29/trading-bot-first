# Copy to .env and fill in. .env is gitignored — never commit real values.

# TWS paper trading default port is 7497; IB Gateway paper default is 4002.
# Live ports are 7496 (TWS) / 4001 (Gateway) — LIVE_TRADING must also be
# explicitly set to true before the bot will trade on a non-paper account.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# run_snapshot.py's own client ID (distinct from IBKR_CLIENT_ID) — it runs
# at the same time as RSI2TradingBot (4:30pm ET) and needs a different ID
# to avoid IBKR's "client id already in use" collision.
SNAPSHOT_CLIENT_ID=99

# run_orb_bot.py's own client ID (long-running intraday process).
ORB_CLIENT_ID=98

# Risk parameters
RISK_PCT_PER_TRADE=0.01
STOP_LOSS_PCT=0.10
MAX_POSITIONS=5
MAX_DAILY_LOSS_PCT=0.03
# Hard cap on a single stock position's notional (shares * price), on top
# of the risk_pct_per_trade sizing formula.
MAX_POSITION_VALUE=2000.0

# Strategy parameters
FAST_MA=20
SLOW_MA=50
TREND_MA=200

# Entry confirmation filters (set a window/period to 0 to disable that filter)
VOLUME_MA=20
VOLUME_FAST_MA=5
VOLUME_MULTIPLIER=1.0
BREAKOUT_VOLUME_MULTIPLIER=1.2
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_EXIT_OVERBOUGHT=80
VWAP_WINDOW=20
VWAP_RETEST_TOLERANCE=0.015

# Consolidation-breakout-retest pattern (second, independent entry path)
CONSOLIDATION_RETEST_ENABLED=true
CONSOLIDATION_WINDOW=15
CONSOLIDATION_MAX_RANGE_PCT=0.06
CONSOLIDATION_MAX_BARS_SINCE_BREAKOUT=5
CONSOLIDATION_RETEST_TOLERANCE=0.02

# Options ORB strategy (intraday, backtest-only for now)
OPTIONS_SYMBOL=SPY
OPTIONS_BAR_MINUTES=5
OPTIONS_OPENING_RANGE_MINUTES=15
OPTIONS_RISK_PCT_PER_TRADE=0.01
OPTIONS_STOP_LOSS_PCT_OF_PREMIUM=0.30
OPTIONS_PROFIT_TARGET_PCT=0.50
OPTIONS_DTE_DAYS=0
OPTIONS_OTM_PCT=0.0
OPTIONS_STRIKE_INCREMENT=1.0
OPTIONS_VOL_WINDOW=20
OPTIONS_IV_PREMIUM_MULTIPLIER=1.2
OPTIONS_EXIT_ON_RANGE_REENTRY=true
OPTIONS_RATE=0.04
OPTIONS_MAX_CONTRACTS_PER_TRADE=10

# RSI(2) mean-reversion swing strategy (stocks, second/independent strategy)
RSI2_TREND_MA=200
RSI2_PERIOD=2
RSI2_BUY_THRESHOLD=5.0
RSI2_SELL_THRESHOLD=65.0
RSI2_FIB_LOOKBACK=0
RSI2_FIB_ZONE_LOW=0.382
RSI2_FIB_ZONE_HIGH=0.618

# Expand RSI2's daily entry universe with IBKR's top-movers scanner
# (gainers/losers/most-active), on top of RSI2_WATCHLIST. Filtered by
# min price/volume to exclude penny stocks and illiquid names.
RSI2_SCAN_TOP_MOVERS=true
RSI2_SCAN_ROWS=15
RSI2_SCAN_MIN_PRICE=10.0
RSI2_SCAN_MIN_VOLUME=500000

# Blocks a BUY when volume is this many multiples of normal (news/event
# signature, not a technical dip). Partial mitigation, not a complete
# fix — see run_rsi2_bot.py's docstring.
RSI2_VOLUME_SPIKE_WINDOW=20
RSI2_VOLUME_SPIKE_MULTIPLIER=3.0

# Iron condor / credit-spread strategy on SPY, QQQ, IWM (second/independent
# options strategy: sells premium instead of buying it)
CREDIT_SPREAD_TARGET_DELTA=0.16
CREDIT_SPREAD_WING_WIDTH=5.0
CREDIT_SPREAD_DTE_DAYS=45
CREDIT_SPREAD_PROFIT_TARGET_PCT=0.50
CREDIT_SPREAD_STOP_LOSS_MULTIPLE=2.0
CREDIT_SPREAD_DTE_FORCED_CLOSE=21
CREDIT_SPREAD_ENTRY_INTERVAL_DAYS=7
CREDIT_SPREAD_MAX_CONCURRENT=3
CREDIT_SPREAD_RISK_PCT_PER_TRADE=0.02
CREDIT_SPREAD_MAX_CONTRACTS_PER_TRADE=10
# SPY-only for now: QQQ/IWM options fail to fill (data entitlement gap on
# this account). Add "QQQ,IWM" back once that's resolved.
CREDIT_SPREAD_SYMBOLS=SPY
CREDIT_SPREAD_VOL_WINDOW=20
CREDIT_SPREAD_IV_PREMIUM_MULTIPLIER=1.2
CREDIT_SPREAD_RATE=0.04
CREDIT_SPREAD_MIN_VOL_PERCENTILE=0.0
CREDIT_SPREAD_VOL_PERCENTILE_LOOKBACK=252

# "Trend Join Long" intraday gap-and-go on S&P 500 names (run_trend_join_bot.py;
# rules in strategy/trend_join.py). Sizing uses RISK_PCT_PER_TRADE and
# MAX_POSITION_VALUE above; initial stop is also capped by STOP_LOSS_PCT.
TREND_JOIN_CLIENT_ID=97
TREND_JOIN_MIN_GAP_PCT=3.0
TREND_JOIN_MIN_PRICE=3.0
TREND_JOIN_TREND_MA=200
TREND_JOIN_MIN_RVOL=2.0
TREND_JOIN_RVOL_LOOKBACK_DAYS=14
TREND_JOIN_MAX_CANDIDATES=20
TREND_JOIN_MAX_POSITIONS=5
TREND_JOIN_MAX_TRADES_PER_DAY=5
TREND_JOIN_BAR_MINUTES=5
TREND_JOIN_LOD_STOP_BUFFER_PCT=0.01
TREND_JOIN_PARTIAL_R=0.75
TREND_JOIN_PARTIAL_FRACTION=0.3333
TREND_JOIN_BREAKEVEN_R=1.0
TREND_JOIN_SWING_BARS=2
TREND_JOIN_ENTRY_START=10:05
TREND_JOIN_ENTRY_END=15:30
TREND_JOIN_FLATTEN_TIME=15:51
TREND_JOIN_PREFILTER_TIMES=09:55,10:25,10:55,11:25,11:55,12:25,12:55

# Safety: must be explicitly "true" to allow trading on a non-paper (live) account.
LIVE_TRADING=false

# Comma-separated symbol watchlist
WATCHLIST=AAPL,MSFT,AMZN,GOOGL,META,NVDA,JPM,V,UNH,HD,SPCX,TSLA,PLTR,AVGO,ASTX,SOXL,SOXS,LLY,HOOD

# Separate, non-overlapping watchlist for the RSI(2) mean-reversion bot —
# keeps it from ever fighting the MA-crossover bot over the same position.
RSI2_WATCHLIST=XOM,JNJ,PG,KO,DIS,WMT,BAC,PFE,CSCO,INTC

DB_PATH=data/journal.db

# Daily pre/post-market snapshot (see run_snapshot.py): written as HTML
# under REPORTS_DIR and committed to git (no push) automatically.
REPORTS_DIR=reports

# YTD P&L in the snapshot is computed as (current balance - this baseline)
# — IBKR's API has no calendar-YTD tag. $1M is the standard paper-account
# starting default; set to the account's actual Jan 1 balance if different.
ACCOUNT_STARTING_BALANCE=1000000.0
