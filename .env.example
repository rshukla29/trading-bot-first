# Copy to .env and fill in. .env is gitignored — never commit real values.

# TWS paper trading default port is 7497; IB Gateway paper default is 4002.
# Live ports are 7496 (TWS) / 4001 (Gateway) — LIVE_TRADING must also be
# explicitly set to true before the bot will trade on a non-paper account.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Risk parameters
RISK_PCT_PER_TRADE=0.01
STOP_LOSS_PCT=0.10
MAX_POSITIONS=5
MAX_DAILY_LOSS_PCT=0.03

# Strategy parameters
FAST_MA=20
SLOW_MA=50
TREND_MA=200

# Entry confirmation filters (set a window/period to 0 to disable that filter)
VOLUME_MA=20
VOLUME_FAST_MA=5
VOLUME_MULTIPLIER=1.0
BREAKOUT_VOLUME_MULTIPLIER=1.2
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_EXIT_OVERBOUGHT=80
VWAP_WINDOW=20
VWAP_RETEST_TOLERANCE=0.015

# Consolidation-breakout-retest pattern (second, independent entry path)
CONSOLIDATION_RETEST_ENABLED=true
CONSOLIDATION_WINDOW=15
CONSOLIDATION_MAX_RANGE_PCT=0.06
CONSOLIDATION_MAX_BARS_SINCE_BREAKOUT=5
CONSOLIDATION_RETEST_TOLERANCE=0.02

# Options ORB strategy (intraday, backtest-only for now)
OPTIONS_SYMBOL=SPY
OPTIONS_BAR_MINUTES=5
OPTIONS_OPENING_RANGE_MINUTES=15
OPTIONS_RISK_PCT_PER_TRADE=0.01
OPTIONS_STOP_LOSS_PCT_OF_PREMIUM=0.30
OPTIONS_PROFIT_TARGET_PCT=0.50
OPTIONS_DTE_DAYS=0
OPTIONS_OTM_PCT=0.0
OPTIONS_STRIKE_INCREMENT=1.0
OPTIONS_VOL_WINDOW=20
OPTIONS_IV_PREMIUM_MULTIPLIER=1.2
OPTIONS_EXIT_ON_RANGE_REENTRY=true
OPTIONS_RATE=0.04

# Safety: must be explicitly "true" to allow trading on a non-paper (live) account.
LIVE_TRADING=false

# Comma-separated symbol watchlist
WATCHLIST=AAPL,MSFT,AMZN,GOOGL,META,NVDA,JPM,V,UNH,HD

DB_PATH=data/journal.db
